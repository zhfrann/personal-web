---
export const prerender = true;

import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";

const stories = (
  await getCollection("projectStories", ({ data }) => !data.draft)
).sort((a, b) => a.data.order - b.data.order);
---

<Layout
  title="Project Stories"
  description="Long-form stories about the problems, decisions, challenges, and lessons behind my projects."
>
  <main id="main-content" class="mx-auto max-w-5xl">
    <header class="max-w-3xl border-b border-border pb-10 sm:pb-14">
      <a
        href="/#projects"
        class="mb-7 inline-flex min-h-11 items-center gap-2 rounded-full border border-border bg-background px-4 text-sm font-medium transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
      >
        <span aria-hidden="true">←</span>
        Back to main page
      </a>
      <p class="text-base lg:text-lg tracking-[0.22em] text-muted-foreground">
        Project stories
      </p>
      <h1
        class="mt-4 max-w-2xl text-balance text-3xl lg:text-4xl font-semibold tracking-tight sm:text-6xl"
      >
        The work behind the work.
      </h1>
      <p
        class="mt-5 max-w-2xl text-pretty text-base lg:text-lg leading-8 text-muted-foreground"
      >
        A closer look at the problems, product decisions, technical tradeoffs,
        and lessons learn behind each project in my portfolio.
      </p>
    </header>

    <section class="py-10 sm:py-14" aria-labelledby="stories-heading">
      <h2 id="stories-heading" class="sr-only">All project stories</h2>
      <div class="grid gap-5 md:grid-cols-2">
        {
          stories.map((story, index) => {
            const isLastOdd =
              stories.length % 2 !== 0 && index === stories.length - 1;

            return (
              <article
                class={`group flex min-h-full flex-col overflow-hidden rounded-2xl border border-border bg-card transition duration-300 hover:-translate-y-1 hover:border-foreground/25 hover:shadow-lg hover:shadow-foreground/5 ${isLastOdd ? "md:col-span-2 md:mx-auto md:w-[calc(50%-10px)]" : ""}`}
              >
                {story.data.coverImage ? (
                  <a
                    href={`/blog/${story.id}`}
                    class="block overflow-hidden bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring"
                    aria-label={`Read ${story.data.title}`}
                  >
                    <img
                      src={story.data.coverImage}
                      alt=""
                      width="960"
                      height="600"
                      loading="lazy"
                      class="w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
                    />
                  </a>
                ) : (
                  <a
                    href={`/blog/${story.id}`}
                    class="flex aspect-[16/10] items-end bg-muted p-6 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring"
                    aria-label={`Read ${story.data.title}`}
                  >
                    <span class="font-mono text-6xl font-medium tracking-tighter text-muted-foreground/35">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                  </a>
                )}

                <div class="flex flex-1 flex-col p-5 sm:p-6">
                  <h3 class="mt-4 text-2xl font-semibold tracking-tight">
                    <a
                      href={`/blog/${story.id}`}
                      class="rounded-sm underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
                    >
                      {story.data.title}
                    </a>
                  </h3>
                  <p class="mt-3 flex-1 text-pretty leading-7 text-base lg:text-lg text-muted-foreground">
                    {story.data.description}
                  </p>
                  <a
                    href={`/blog/${story.id}`}
                    class="mt-6 flex items-center justify-between border-t border-border pt-5 text-sm lg:text-base font-medium"
                  >
                    <span>Read project story</span>
                    <span
                      aria-hidden="true"
                      class="transition-transform duration-200 group-hover:translate-x-1"
                    >
                      →
                    </span>
                  </a>
                </div>
              </article>
            );
          })
        }
      </div>
    </section>
  </main>
</Layout>
